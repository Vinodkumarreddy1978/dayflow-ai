# =============================================================================
# DayFlow AI - environment template
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public base URL. Used for auth redirects, push notification deep links and
# absolute URLs in emails.
#
# Required, with no path and no trailing slash - redirect targets are built by
# appending a path to it. In a deployment this must be the deployed origin: it is
# what Supabase puts in confirmation and password reset emails, so leaving it as
# localhost produces links that only work on the machine that sent them.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Project settings -> API. The anon key is safe in the browser because every
# table is protected by row level security.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses row level security, so it is used exclusively by cron
# routes that must act across all users (reminders, auto-close, AI reports).
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Web push (VAPID)
# Generate a key pair with: npm run vapid:generate
#
# Leave both keys empty to run without push. Settings then reports notifications
# as unconfigured for the device instead of offering a button that cannot work.
# A public key that is present but not a real 87-character VAPID key fails the
# build, because the alternative is an opaque browser error at subscribe time.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# -----------------------------------------------------------------------------
# Scheduled jobs
# Shared secret sent as `Authorization: Bearer <CRON_SECRET>` by Vercel Cron and
# by Supabase pg_cron. Requests without it are rejected. Minimum 16 characters.
#
#   macOS / Linux:  openssl rand -base64 48
#   Windows:        $b = New-Object byte[] 48
#                   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#                   [Convert]::ToBase64String($b)
#
# This value must also be stored in Supabase Vault as `dayflow_cron_secret`, or
# scheduled reminders will not fire. See README step 7.
# -----------------------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string

# -----------------------------------------------------------------------------
# AI provider (server side only)
# The engine is provider agnostic; set AI_PROVIDER to the one you use.
# Leave AI_ENABLED=false to run the whole product with AI features disabled.
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
